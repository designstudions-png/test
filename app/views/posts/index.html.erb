<header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <h1 style="margin: 0;">Мой Блог</h1>
  <% if logged_in? %>
    <%= link_to "Новый пост", new_post_path, class: "button" %>
  <% end %>
</header>

<div id="posts">
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="post-item">
        <div class="post-content">
          <h2 style="margin-bottom: 0.5rem;"><%= link_to post.title, post %></h2>
          <div style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">
            <%= l post.created_at, format: :long %>
          </div>

          <div style="margin-bottom: 1rem;">
            <%= truncate(post.body, length: 240) %>
          </div>
          <%= link_to "Читать далее →", post, style: "font-weight: 500;" %>
        </div>

        <% if post.images.attached? %>
          <div class="post-image">
            <%= image_tag post.images.first, alt: post.title %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div style="text-align: center; padding: 3rem; color: var(--text-muted);">
      <p>Пока здесь ничего нет. <%= "Станьте первым, кто напишет пост!" if logged_in? %></p>
      <% if logged_in? %>
        <%= link_to "Написать первый пост", new_post_path, class: "button" %>
      <% end %>
    </div>
  <% end %>
</div>
