<article class="post-full">
  <header style="margin-bottom: 2rem;">
    <h1 style="margin-bottom: 0.5rem; font-size: 2.5rem;"><%= @post.title %></h1>
    <div style="color: var(--text-muted); font-size: 0.95rem;">
      Опубликовано <%= l @post.created_at, format: :long %>
    </div>
  </header>

  <div style="font-size: 1.15rem; line-height: 1.8; margin-bottom: 2rem; color: #334155;">
    <%= simple_format @post.body %>
  </div>

  <% if @post.images.attached? %>
    <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 3rem;">
      <% @post.images.each do |image| %>
        <div style="border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);">
          <%= image_tag image, style: "width: 100%; height: auto; display: block;" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div style="display: flex; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-bottom: 4rem;">
    <%= link_to "← Назад", posts_path, class: "button button-secondary" %>
    <% if @post.user == current_user || admin? %>
      <div style="margin-left: auto; display: flex; gap: 10px;">
        <%= link_to "Редактировать", edit_post_path(@post), class: "button button-secondary" %>
        <%= button_to "Удалить", @post, method: :delete,
                      form: { style: "display: inline-block;" },
                      class: "button",
                      style: "background-color: var(--danger-color);",
                      data: { turbo_confirm: "Вы уверены?" } %>
      </div>
    <% end %>
  </div>
</article>

<section id="comments">
  <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Комментарии (<%= @post.comments.count %>)</h2>

  <div id="comments_list">
    <% if @post.comments.exists? %>
      <%= render @post.comments.where.not(id: nil).order(created_at: :asc) %>
    <% else %>
      <p style="color: var(--text-muted); margin-bottom: 2rem;">Комментариев пока нет.</p>
    <% end %>
  </div>

  <% if logged_in? %>
    <div style="margin-top: 2rem; padding: 1.5rem; background: #fff; border: 1px solid var(--border-color); border-radius: 12px;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Добавить комментарий</h3>
      <%= form_with(model: [@post, @post.comments.build]) do |f| %>
        <div class="field">
          <%= f.text_area :body, rows: 3, placeholder: "Что вы об этом думаете?", required: true %>
        </div>
        <%= f.submit "Опубликовать", class: "button" %>
      <% end %>
    </div>
  <% else %>
    <div style="margin-top: 2rem; padding: 1.5rem; background: #f8fafc; border: 1px dashed var(--border-color); border-radius: 12px; text-align: center;">
      <p style="color: var(--text-muted);">
        <%= link_to "Войдите", new_session_path %> или <%= link_to "зарегистрируйтесь", new_registration_path %>, чтобы оставить комментарий.
      </p>
    </div>
  <% end %>
</section>
