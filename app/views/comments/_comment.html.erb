<div id="<%= dom_id comment %>" style="background: #f9f9f9; padding: 10px; margin-bottom: 10px; border-radius: 4px; border: 1px solid #eee;">
  <%= simple_format comment.body %>
  <small>Опубликовано <%= time_ago_in_words(comment.created_at) %> назад</small>
  <div style="margin-top: 5px;">
    <%= button_to "Удалить", [comment.post, comment], method: :delete, data: { confirm: "Уверены?" }, style: "color: red; font-size: 0.8rem; background: none; border: none; padding: 0; cursor: pointer;" %>
  </div>
</div>
