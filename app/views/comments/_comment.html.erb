<div id="<%= dom_id comment %>" class="comment" style="margin-bottom: 1.5rem; padding: 1.25rem; background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px;">
  <div style="font-size: 1rem; color: var(--text-main); margin-bottom: 0.75rem;">
    <%= simple_format comment.body %>
  </div>

  <% if comment.images.attached? %>
    <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 1rem;">
      <% comment.images.each do |image| %>
        <div style="max-width: 200px; border-radius: 4px; overflow: hidden; border: 1px solid var(--border-color);">
          <%= image_tag image, style: "width: 100%; height: auto; display: block;" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="comment-meta" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 1rem; margin-top: 1rem;">
    <span style="font-size: 0.85rem; color: var(--text-muted);">
      <strong><%= comment.user&.email || "Аноним" %></strong> • <%= time_ago_in_words(comment.created_at) %> назад
    </span>

    <% if comment.user == current_user || admin? %>
      <%= button_to "Удалить", [comment.post, comment],
                    method: :delete,
                    class: "delete-link",
                    data: { turbo_confirm: "Удалить этот комментарий?" } %>
    <% end %>
  </div>
</div>
